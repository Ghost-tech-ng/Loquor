{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // lib/metrics.ts imports lib/lexicon.ts with an explicit extension so that
    // `node --experimental-strip-types --test` can run the pure modules directly.
    // Metro resolves the literal path fine; tsc needs telling.
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
