{
  "expo": {
    "name": "PipeUp",
    "slug": "loquor",
    "owner": "osemwegieeghosa",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "scheme": "pipeup",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F17",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eghosa.loquor",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PipeUp listens to your practice so it can score your pace, pauses, fillers and liveliness. Audio is deleted after it is analysed."
      }
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F17"
        }
      ],
      "expo-sharing"
    ],
    "updates": {
      "url": "https://u.expo.dev/dace44de-b31f-4aab-99e0-0fe192e03b1c",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dace44de-b31f-4aab-99e0-0fe192e03b1c"
      }
    },
    "icon": "./assets/icon.png"
  }
}
