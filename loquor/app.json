{
  "expo": {
    "name": "Loquor",
    "slug": "loquor",
    "owner": "osemwegieeghosa",
    "version": "1.0.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "scheme": "loquor",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#150F1C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eghosa.loquor",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Loquor records your practice answers so it can measure pace, pauses and filler words. Audio is deleted after transcription."
      }
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-sqlite",
      "expo-font"
    ],
    "updates": {
      "url": "https://u.expo.dev/dace44de-b31f-4aab-99e0-0fe192e03b1c",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dace44de-b31f-4aab-99e0-0fe192e03b1c"
      }
    }
  }
}
