rules_version = '2';

// The only thing between one user's backup and everyone else. The web API key
// in features/backup/cloud.ts is public by design, so these rules are the security model,
// not a layer on top of one. Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Exactly the two shapes features/backup/backup.ts writes. Anything else under a user's
    // tree is refused, so a bug that writes somewhere new fails loudly instead
    // of quietly growing an unbacked-up, unrestorable corner of the database.
    match /users/{uid}/meta/manifest {
      allow read, delete: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['json'])
        && request.resource.data.json is string;
    }

    match /users/{uid}/chunks/{chunk} {
      allow read, delete: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['table', 'hash', 'rows', 'data'])
        && request.resource.data.table is string
        && request.resource.data.hash is string;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
